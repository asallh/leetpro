# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ────────────────────────────────
/node_modules
/.pnp
.pnp.*
.pnpm-store/

# ── Build output ────────────────────────────────
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Prisma generated client (rebuilt by `prisma generate`)
/src/generated/prisma

# Packed browser extension builds
/extension/*.zip
*.crx

# ── Testing ─────────────────────────────────────
/coverage

# ── Env & secrets ───────────────────────────────
.env*
!.env.example
*.pem

# ── Logs ────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Caches ──────────────────────────────────────
.eslintcache

# ── Deployment ──────────────────────────────────
.vercel

# ── OS & editors ────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# ── AI agent tooling ────────────────────────────
# Installed third-party skills are reproducible from skills-lock.json,
# so only the lockfile is committed.
/.agents/
/.claude/skills/
/.windsurf/
# Per-user Claude settings (shared .claude/launch.json stays tracked)
/.claude/settings.local.json
# gstack browser session logs
/.gstack/
