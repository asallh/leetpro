# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://leetpro:leetpro@localhost:5432/leetpro
# Direct (non-pooled) connection for Prisma migrations. On Neon, `neon env pull`
# sets DATABASE_URL to the -pooler host and this to the direct host. Leave it
# empty locally; migrations then fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
ENV=DEV

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Chrome extension IDs allowed to call the auth API.
# Required in production; development allows any extension when unset.
LEETPRO_EXTENSION_IDS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional site-wide password gate for private deployments (e.g. a dev
# instance for friends). When set, every page asks for it once at /gate.
# Use a long random value: openssl rand -base64 24
SITE_PASSWORD=

# Header your host sets to the real client IP, used for rate limiting
# (e.g. x-real-ip, x-vercel-forwarded-for, cf-connecting-ip, fly-client-ip).
# Leave empty to fall back to x-real-ip, then the last x-forwarded-for hop.
RATE_LIMIT_IP_HEADER=
