# Matches docker-compose.yml defaults
DATABASE_URL=postgresql://leetpro:leetpro@localhost:5432/leetpro
ENV=DEV

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Chrome extension IDs allowed to call the auth API.
# Required in production; development allows any extension when unset.
LEETPRO_EXTENSION_IDS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
